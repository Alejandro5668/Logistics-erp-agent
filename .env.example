# cp .env.example .env — luego descomenta UNA opción y completa tu clave.
# No hace falta para `pytest -v` (usa un modelo falso).

# Azure OpenAI (default) -> pip install langchain-openai
# AGENT_MODEL=azure_openai:gpt-4o
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# Anthropic -> pip install langchain-anthropic
# AGENT_MODEL=anthropic:claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# OpenAI -> pip install langchain-openai
# AGENT_MODEL=openai:gpt-4o
# OPENAI_API_KEY=

# ERP_DB_PATH=data/erp_mock.db
# CHROMA_DB_PATH=data/chroma
